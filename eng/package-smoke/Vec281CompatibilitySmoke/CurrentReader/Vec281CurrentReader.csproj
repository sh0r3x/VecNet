<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <VecNetPackageVersion Condition="'$(VecNetPackageVersion)' == ''">0.0.0-local</VecNetPackageVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="VecNet" Version="$(VecNetPackageVersion)" />
  </ItemGroup>

</Project>
