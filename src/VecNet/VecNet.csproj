<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>VecNet</PackageId>
    <Version>1.2.1</Version>
    <Title>VecNet</Title>
    <Authors>VecNet Contributors</Authors>
    <Description>Pure-managed embedded .NET vector indexing library for exact vector search, durable snapshots, filtering, updates, and HNSW approximate search for squared-L2 and cosine distance. The core package is dependency-free and this metadata makes no public performance or platform claim.</Description>
    <RepositoryUrl>https://github.com/sh0r3x/VecNet.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/sh0r3x/VecNet</PackageProjectUrl>
    <PackageTags>vector-search;vector-indexing;dotnet;embedded;managed</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageValidationBaselineVersion>1.2.0</PackageValidationBaselineVersion>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="" />
    <None Include="../../LICENSE" Pack="true" PackagePath="" />
  </ItemGroup>

</Project>
