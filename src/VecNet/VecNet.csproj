<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>VecNet</PackageId>
    <Version>0.1.0-preview.2</Version>
    <Title>VecNet</Title>
    <Authors>VecNet Contributors</Authors>
    <Description>Pure-managed embedded .NET vector indexing library for the 0.1 preview package. Current metadata does not indicate stable API admission, production readiness or public performance claims.</Description>
    <RepositoryUrl>https://github.com/sh0r3x/VecNet.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/sh0r3x/VecNet</PackageProjectUrl>
    <PackageTags>vector-search;vector-indexing;dotnet;embedded;managed;preview</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="" />
    <None Include="../../LICENSE" Pack="true" PackagePath="" />
  </ItemGroup>

</Project>
